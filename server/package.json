{
  "name": "docspace-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:sharing": "node --test tests/sharing.integration.test.js",
    "test:exports": "node --test tests/exports.integration.test.js",
    "db": "npm run db:migrate",
    "db:generate": "drizzle-kit generate --config drizzle.config.js",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.js",
    "db:check": "tsx src/config/verify-db.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "html-to-docx": "^1.8.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.20.2",
    "pg": "^8.18.1",
    "turndown": "^7.2.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.11.11",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "image-size": "^2.0.4",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
